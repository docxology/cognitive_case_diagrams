.DS_Store
._*
__pycache__/
*.py[cod]
*.egg-info/
.coverage
coverage.json
.hypothesis/
.pytest_cache/

# LaTeX build intermediates (regenerated by the slide/PDF pipeline)
*.aux
*.log
*.toc
*.nav
*.snm
*.vrb

# Pipeline state checkpoints (tell a fresh clone stale "stages complete" lies)
output/.checkpoints/*.json

# Generated validation/test/telemetry reports (stale PASS artifacts; regenerate)
output/reports/output_statistics.*
output/reports/telemetry.*
output/reports/test_results.*
output/reports/validation_report.*

# 13 MB rendered deliverables: archived on Zenodo (10.5281/zenodo.19695260)
# and regenerated by the render pipeline; keeping them in git cost ~38 MB of
# pack across five revisions of the same artifact.
cognitive_case_diagrams_v1_*.pdf
output/pdf/cognitive_case_diagrams_combined.pdf

# Generated HTML render of the manuscript (regenerated by the web pipeline;
# a tracked copy goes stale the moment the source changes)
output/web/

# LaTeX/PDF build intermediates and the slide .tex sources (all regenerated
# by the render pipeline; .gitignore already covers .aux/.log/.toc etc.)
output/pdf/_combined_manuscript.*
output/pdf/_xelatex_stdout.log
output/slides/*.tex

# Engine-copied build input (source: docs/manuscript/references.bib)
output/pdf/references.bib
