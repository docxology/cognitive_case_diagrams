\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Side-by-side comparison of three alignment systems realized as functors from the universal category \(\symcal {U} = \{S, A, P\}\). \textbf  {Nominative--Accusative}: \(F_{\text  {acc}}(S) = F_{\text  {acc}}(A) = \text  {NOM}\), \(F_{\text  {acc}}(P) = \text  {ACC}\) (kernel \(\{(S,A)\}\), \citep  {eq:eq-2-3}). \textbf  {Ergative--Absolutive}: \(F_{\text  {erg}}(S) = F_{\text  {erg}}(P) = \text  {ABS}\), \(F_{\text  {erg}}(A) = \text  {ERG}\) (kernel \(\{(S,P)\}\), \citep  {eq:eq-2-4}). \textbf  {Tripartite}: \(F_{\text  {tri}}\) is injective (kernel \(\emptyset \))---each role receives distinct marking. Color-coded nodes reveal the neutralization pattern: shared colors indicate functor identification of roles.}}{14}{figure.4}\protected@file@percent }
\newlabel{fig:alignment}{{4}{14}{Side-by-side comparison of three alignment systems realized as functors from the universal category \(\mathcal {U} = \{S, A, P\}\). \textbf {Nominative--Accusative}: \(F_{\text {acc}}(S) = F_{\text {acc}}(A) = \text {NOM}\), \(F_{\text {acc}}(P) = \text {ACC}\) (kernel \(\{(S,A)\}\), \citep {eq:eq-2-3}). \textbf {Ergative--Absolutive}: \(F_{\text {erg}}(S) = F_{\text {erg}}(P) = \text {ABS}\), \(F_{\text {erg}}(A) = \text {ERG}\) (kernel \(\{(S,P)\}\), \citep {eq:eq-2-4}). \textbf {Tripartite}: \(F_{\text {tri}}\) is injective (kernel \(\emptyset \))---each role receives distinct marking. Color-coded nodes reveal the neutralization pattern: shared colors indicate functor identification of roles}{figure.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {3.3.3}Enriched Morphisms, Proto-Roles, and Graded Structure}{14}{subsubsection.3.3.3}\protected@file@percent }
\newlabel{enriched-morphisms-proto-roles-and-graded-structure}{{3.3.3}{14}{Enriched Morphisms, Proto-Roles, and Graded Structure}{subsubsection.3.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Categorical composition in the enriched case category: morphism \(f\colon  \text  {NOM}\to \text  {ACC}\) (transitive action, \(w_f=0.9\)) and morphism \(g\colon  \text  {ACC}\to \text  {DAT}\) (transfer, \(w_g=0.7\)) compose to yield \(g \circ f\colon  \text  {NOM}\to \text  {DAT}\) with weight \(w(g \circ f) = w_g \cdot w_f = 0.63\) (\citep  {eq:eq-2-1}). The commutative triangle encodes that indirect object (DAT) assignment factors through the direct object (ACC)---the multiplicative attenuation reflects the typological observation that subject--recipient relations are weaker than the individual subject--object and object--recipient links.}}{15}{figure.5}\protected@file@percent }
\newlabel{fig:composition}{{5}{15}{Categorical composition in the enriched case category: morphism \(f\colon \text {NOM}\to \text {ACC}\) (transitive action, \(w_f=0.9\)) and morphism \(g\colon \text {ACC}\to \text {DAT}\) (transfer, \(w_g=0.7\)) compose to yield \(g \circ f\colon \text {NOM}\to \text {DAT}\) with weight \(w(g \circ f) = w_g \cdot w_f = 0.63\) (\citep {eq:eq-2-1}). The commutative triangle encodes that indirect object (DAT) assignment factors through the direct object (ACC)---the multiplicative attenuation reflects the typological observation that subject--recipient relations are weaker than the individual subject--object and object--recipient links}{figure.5}{}}
