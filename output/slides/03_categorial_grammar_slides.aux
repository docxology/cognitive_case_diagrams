\newlabel{string-diagrams-for-syntactic-derivation}{{4}{4}{Categorial Grammar: Type Logic and String Diagrams}{string-diagrams-for-syntactic-derivation}{}}
\@writefile{snm}{\beamer@slide {string-diagrams-for-syntactic-derivation}{4}}
\newlabel{fig:string-diagram}{{1}{4}{A 1×3 visualization of DisCoPy pregroup grammar derivations showing increasing sentence complexity. Panel (a): intransitive ``Bob runs'' (NOM) with one cup. Panel (b): transitive ``Alice chases Bob'' (NOM+ACC) with two cups contracting noun types into the verb. Panel (c): passive ``Bob is-chased'' showing patient promotion to subject position via a reduced pregroup type}{fig:string-diagram}{}}
\@writefile{snm}{\beamer@slide {fig:string-diagram}{4}}
\newlabel{fig:multilingual-isomorphism}{{2}{4}{Structural isomorphism of pregroup grammar derivations across 3 typologically diverse languages: English (SVO), Latin (inflected, free order), and Japanese (agglutinative, SOV). Each image renders the transitive meaning ``SUBJ chases OBJ'' as a DisCoPy string diagram with identical type-logical structure---\(n \otimes (n^r \otimes s \otimes n^l) \otimes n \to s\)---demonstrating that the meaning functor's type reduction is invariant under surface word-order permutation. This confirms the central claim of categorial grammar: syntactic universals reside in the type algebra, not in linear word order}{fig:multilingual-isomorphism}{}}
\@writefile{snm}{\beamer@slide {fig:multilingual-isomorphism}{4}}
\newlabel{fig:discopy-transitive}{{3}{4}{DisCoPy rendering of the pregroup derivation for ``Alice chases Bob,'' corresponding to the code block above. The three Word boxes carry types \(n\) (Alice), \(n^r \otimes s \otimes n^l\) (chases), and \(n\) (Bob). Two Cup contractions \(\varepsilon \colon n^r \otimes n \to 1\) and \(\varepsilon \colon n^l \otimes n \to 1\) cancel adjoint type pairs, reducing the five-wire tensor product to the single sentence wire \(s\). By the Curry--Howard correspondence, this diagram is simultaneously a syntactic derivation, a proof of well-typedness, and (under the meaning functor of \autoref {sec:categorical-semantics}) a specification of compositional semantic computation. Our novel extension, \textbf {DisCoCirc entity wires}, decorates these \(n\)-typed wires with functorial states \(S: \mathbf {Ent} \to \mathbf {Case}\), tracking role assignments across discourse boundaries}{fig:discopy-transitive}{}}
\@writefile{snm}{\beamer@slide {fig:discopy-transitive}{4}}
