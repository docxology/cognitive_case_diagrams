\newlabel{graded-proto-roles-as-01-weighted-morphisms}{{5.3}{17}{\texorpdfstring {Graded Proto-Roles as \([0,1]\)-Weighted Morphisms}{Graded Proto-Roles as {[}0,1{]}-Weighted Morphisms}}{subsection.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Eight case roles form a directed graph with weighted grammatical morphisms. The standard linguistic case category \(\symcal {C}\) with objects NOM, ACC, GEN, DAT, INS, LOC, ABL, VOC and directed morphisms encoding grammatical relations. Edge labels identify relation types (acts\_on: NOM\(\to \)ACC, possesses: GEN\(\to \)NOM, received\_by: ACC\(\to \)DAT, located\_at: NOM\(\to \)LOC); edge weights \(w \in [0,1]\) reflect proto-role satisfaction per Dowty's \citeyearpar  {dowty1991thematic} decomposition. The enriched structure over \(([0,1], \cdot , 1)\) ensures multiplicative weight attenuation under composition (\autoref {eq:eq-2-1}). Generated programmatically from the \texttt {CaseCategory} class.}}{18}{figure.caption.4}\protected@file@percent }
\newlabel{fig:case-standard}{{3}{18}{Eight case roles form a directed graph with weighted grammatical morphisms. The standard linguistic case category \(\mathcal {C}\) with objects NOM, ACC, GEN, DAT, INS, LOC, ABL, VOC and directed morphisms encoding grammatical relations. Edge labels identify relation types (acts\_on: NOM\(\to \)ACC, possesses: GEN\(\to \)NOM, received\_by: ACC\(\to \)DAT, located\_at: NOM\(\to \)LOC); edge weights \(w \in [0,1]\) reflect proto-role satisfaction per Dowty's \citeyearpar {dowty1991thematic} decomposition. The enriched structure over \(([0,1], \cdot , 1)\) ensures multiplicative weight attenuation under composition (\autoref {eq:eq-2-1}). Generated programmatically from the \protect \texttt {CaseCategory} class}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Functor kernels uniquely fingerprint each alignment typology. Three alignment systems realized as functors from \(\symcal {U} = \{S, A, P\}\): \textbf  {Nominative--Accusative} merges \(\{S,A\} \to \text  {NOM}\) (kernel \(\{(S,A)\}\), \autoref {eq:eq-2-3}); \textbf  {Ergative--Absolutive} merges \(\{S,P\} \to \text  {ABS}\) (kernel \(\{(S,P)\}\), \autoref {eq:eq-2-4}); \textbf  {Tripartite} is injective (kernel \(\emptyset \)). Color-coded nodes reveal neutralization patterns: shared colors indicate functor identification of roles. Generated programmatically from the \texttt {CaseCategory} implementation.}}{19}{figure.caption.5}\protected@file@percent }
\newlabel{fig:alignment}{{4}{19}{Functor kernels uniquely fingerprint each alignment typology. Three alignment systems realized as functors from \(\mathcal {U} = \{S, A, P\}\): \textbf {Nominative--Accusative} merges \(\{S,A\} \to \text {NOM}\) (kernel \(\{(S,A)\}\), \autoref {eq:eq-2-3}); \textbf {Ergative--Absolutive} merges \(\{S,P\} \to \text {ABS}\) (kernel \(\{(S,P)\}\), \autoref {eq:eq-2-4}); \textbf {Tripartite} is injective (kernel \(\emptyset \)). Color-coded nodes reveal neutralization patterns: shared colors indicate functor identification of roles. Generated programmatically from the \protect \texttt {CaseCategory} implementation}{figure.caption.5}{}}
\newlabel{eq:eq-2-1}{{3}{19}{\texorpdfstring {Graded Proto-Roles as \([0,1]\)-Weighted Morphisms}{Graded Proto-Roles as {[}0,1{]}-Weighted Morphisms}}{equation.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Alignment Shifts as Natural Transformations: Functor Commutativity Encodes Grammar Agreement}{19}{subsection.5.4}\protected@file@percent }
\newlabel{alignment-shifts-as-natural-transformations-functor-commutativity-encodes-grammar-agreement}{{5.4}{19}{Alignment Shifts as Natural Transformations: Functor Commutativity Encodes Grammar Agreement}{subsection.5.4}{}}
\newlabel{eq:eq-2-2}{{4}{19}{Alignment Shifts as Natural Transformations: Functor Commutativity Encodes Grammar Agreement}{equation.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Morphism composition attenuates weights multiplicatively through intermediate case roles. Morphism \(f\colon  \text  {NOM}\to \text  {ACC}\) (acts\_on) and \(g\colon  \text  {ACC}\to \text  {DAT}\) (received\_by) compose to \(h = g \circ f\colon  \text  {NOM}\to \text  {DAT}\) per \autoref {eq:eq-2-1}; in the enriched category weights multiply (e.g., \(w_f = 0.9\), \(w_g = 0.7 \Rightarrow w(g \circ f) = 0.63\)). The commutative triangle encodes that DAT assignment factors through ACC---the multiplicative attenuation reflects the typological observation that subject--recipient relations are weaker than the constituent subject--object and object--recipient links. Generated programmatically from the \texttt {CaseCategory} class.}}{20}{figure.caption.6}\protected@file@percent }
\newlabel{fig:composition}{{5}{20}{Morphism composition attenuates weights multiplicatively through intermediate case roles. Morphism \(f\colon \text {NOM}\to \text {ACC}\) (acts\_on) and \(g\colon \text {ACC}\to \text {DAT}\) (received\_by) compose to \(h = g \circ f\colon \text {NOM}\to \text {DAT}\) per \autoref {eq:eq-2-1}; in the enriched category weights multiply (e.g., \(w_f = 0.9\), \(w_g = 0.7 \Rightarrow w(g \circ f) = 0.63\)). The commutative triangle encodes that DAT assignment factors through ACC---the multiplicative attenuation reflects the typological observation that subject--recipient relations are weaker than the constituent subject--object and object--recipient links. Generated programmatically from the \protect \texttt {CaseCategory} class}{figure.caption.6}{}}
