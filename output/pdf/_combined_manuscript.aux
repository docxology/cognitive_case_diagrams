\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Entity persistence across sentence boundaries enables case role tracking. A DisCoCirc-style discourse diagram for ``Alice chases Bob. Bob runs.'' generated via DisCoPy's pregroup grammar. \textbf  {Sentence 1}: three Word boxes contract Alice (\(n\)) and Bob (\(n\)) into the transitive verb ``chases'' (\(n^r \otimes s \otimes n^l\)), producing sentence type \(s\). \textbf  {Sentence 2}: Bob (\(n\)) contracts into the intransitive ``runs'' (\(n^r \otimes s\)), producing a second \(s\). The full discourse type is \(s \otimes s\), encoding inter-sentential coherence. In a full DisCoCirc implementation, Bob's shared entity wire would carry accumulated semantic state across the sentence boundary---the foundation for dynamic case role tracking in \autoref {fig:three-sentence-discourse}.}}{31}{figure.15}\protected@file@percent }
\newlabel{fig:discourse}{{15}{31}{Entity persistence across sentence boundaries enables case role tracking. A DisCoCirc-style discourse diagram for ``Alice chases Bob. Bob runs.'' generated via DisCoPy's pregroup grammar. \textbf {Sentence 1}: three Word boxes contract Alice (\(n\)) and Bob (\(n\)) into the transitive verb ``chases'' (\(n^r \otimes s \otimes n^l\)), producing sentence type \(s\). \textbf {Sentence 2}: Bob (\(n\)) contracts into the intransitive ``runs'' (\(n^r \otimes s\)), producing a second \(s\). The full discourse type is \(s \otimes s\), encoding inter-sentential coherence. In a full DisCoCirc implementation, Bob's shared entity wire would carry accumulated semantic state across the sentence boundary---the foundation for dynamic case role tracking in \autoref {fig:three-sentence-discourse}}{figure.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.2}Alice's Trajectory NOM→ACC→NOM}{31}{subsection.10.2}\protected@file@percent }
\newlabel{alices-trajectory-nomaccnom}{{10.2}{31}{Alice's Trajectory NOM→ACC→NOM}{subsection.10.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Wire colour directly encodes dynamic case-role transitions across sentence boundaries. Native matplotlib DisCoCirc diagram for ``Alice chases Bob. Bob runs.'' generated via \texttt {src.visualization.string\_diagrams.render\_discocirc\_discourse()}, cross-validating \autoref {fig:discourse} without library dependency. \textbf  {Vertical wires} (grey) are persistent entity wires for Alice and Bob. At each sentence boundary, a coloured disc marks Bob's case role: \textbf  {red} (ACC) in sentence 1 (chased object), \textbf  {blue} (NOM) in sentence 2 (running agent). The ACC \(\to \) NOM transition is read directly from wire colour at successive levels. This confirms that our native string-diagram module correctly resolves entity identity and tracks role reassignment using \texttt {src.diagrams.string\_diagram.Discourse} data structures.}}{32}{figure.16}\protected@file@percent }
\newlabel{fig:native-discourse}{{16}{32}{Wire colour directly encodes dynamic case-role transitions across sentence boundaries. Native matplotlib DisCoCirc diagram for ``Alice chases Bob. Bob runs.'' generated via \protect \texttt {src.visualization.string\_diagrams.render\_discocirc\_discourse()}, cross-validating \autoref {fig:discourse} without library dependency. \textbf {Vertical wires} (grey) are persistent entity wires for Alice and Bob. At each sentence boundary, a coloured disc marks Bob's case role: \textbf {red} (ACC) in sentence 1 (chased object), \textbf {blue} (NOM) in sentence 2 (running agent). The ACC \(\to \) NOM transition is read directly from wire colour at successive levels. This confirms that our native string-diagram module correctly resolves entity identity and tracks role reassignment using \protect \texttt {src.diagrams.string\_diagram.Discourse} data structures}{figure.16}{}}
