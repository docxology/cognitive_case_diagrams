\newlabel{categorical-formalization-of-case-systems}{{4}{4}{Case Systems: Typology, Alignment, and Graded Roles}{categorical-formalization-of-case-systems}{}}
\@writefile{snm}{\beamer@slide {categorical-formalization-of-case-systems}{4}}
\newlabel{case-categories-as-directed-graphs}{{4}{4}{Case Systems: Typology, Alignment, and Graded Roles}{case-categories-as-directed-graphs}{}}
\@writefile{snm}{\beamer@slide {case-categories-as-directed-graphs}{4}}
\newlabel{fig:case-standard}{{2}{4}{The standard linguistic case category \(\mathcal {C}\) with eight objects (NOM, ACC, GEN, DAT, INS, LOC, ABL, VOC) and directed morphisms encoding grammatical relations. Edge labels identify relation types (transitive\_action: NOM\(\to \)ACC, possession: GEN\(\to \)NOM, transfer: ACC\(\to \)DAT, spatial\_grounding: LOC\(\to \)ACC) while edge weights \(w \in [0,1]\) reflect proto-role satisfaction per Dowty's {[}-@dowty1991thematic{]} decomposition. The enriched structure over \(([0,1], \cdot , 1)\) ensures that composition attenuates weights multiplicatively ({[}@eq:eq-2-1{]}): a chain NOM\(\to \)ACC\(\to \)DAT with weights \(0.9\) and \(0.7\) yields composite weight \(0.63\). Generated programmatically from the \protect \texttt {CaseCategory} class}{fig:case-standard}{}}
\@writefile{snm}{\beamer@slide {fig:case-standard}{4}}
\newlabel{alignment-functors-between-case-categories}{{4}{4}{Case Systems: Typology, Alignment, and Graded Roles}{alignment-functors-between-case-categories}{}}
\@writefile{snm}{\beamer@slide {alignment-functors-between-case-categories}{4}}
\newlabel{fig:alignment}{{3}{4}{Side-by-side comparison of three alignment systems realized as functors from the universal category \(\mathcal {U} = \{S, A, P\}\). \textbf {Nominative--Accusative}: \(F_{\text {acc}}(S) = F_{\text {acc}}(A) = \text {NOM}\), \(F_{\text {acc}}(P) = \text {ACC}\) (kernel \(\{(S,A)\}\), {[}@eq:eq-2-3{]}). \textbf {Ergative--Absolutive}: \(F_{\text {erg}}(S) = F_{\text {erg}}(P) = \text {ABS}\), \(F_{\text {erg}}(A) = \text {ERG}\) (kernel \(\{(S,P)\}\), {[}@eq:eq-2-4{]}). \textbf {Tripartite}: \(F_{\text {tri}}\) is injective (kernel \(\emptyset \))---each role receives distinct marking. Color-coded nodes reveal the neutralization pattern: shared colors indicate functor identification of roles}{fig:alignment}{}}
\@writefile{snm}{\beamer@slide {fig:alignment}{4}}
\newlabel{fig:composition}{{4}{4}{Categorical composition in the enriched case category: morphism \(f\colon \text {NOM}\to \text {ACC}\) (transitive action, \(w_f=0.9\)) and morphism \(g\colon \text {ACC}\to \text {DAT}\) (transfer, \(w_g=0.7\)) compose to yield \(g \circ f\colon \text {NOM}\to \text {DAT}\) with weight \(w(g \circ f) = w_g \cdot w_f = 0.63\) ({[}@eq:eq-2-1{]}). The commutative triangle encodes that indirect object (DAT) assignment factors through the direct object (ACC)---the multiplicative attenuation reflects the typological observation that subject--recipient relations are weaker than the individual subject--object and object--recipient links}{fig:composition}{}}
\@writefile{snm}{\beamer@slide {fig:composition}{4}}
\newlabel{enriched-morphisms-proto-roles-and-graded-structure}{{4}{4}{Case Systems: Typology, Alignment, and Graded Roles}{enriched-morphisms-proto-roles-and-graded-structure}{}}
\@writefile{snm}{\beamer@slide {enriched-morphisms-proto-roles-and-graded-structure}{4}}
